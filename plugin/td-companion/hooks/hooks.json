{
	"description": "Provides the configured TouchDesigner endpoint and reminds Claude to verify mutations",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/td-config-context.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "mcp__.+__(create_td_node|update_td_node_parameters|delete_td_node|exec_node_method|execute_python_script)",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/td-verify-reminder.sh\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
